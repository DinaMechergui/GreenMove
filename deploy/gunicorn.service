[Unit]
Description=Gunicorn Daemon pour GreenMove (HTTP)
After=network.target

[Service]
User=greenmove
Group=www-data
WorkingDirectory=/var/www/greenmove
ExecStart=/var/www/greenmove/venv/bin/gunicorn \
          --workers 4 \
          --bind 127.0.0.1:8000 \
          --access-logfile /var/log/greenmove/gunicorn_access.log \
          --error-logfile /var/log/greenmove/gunicorn_error.log \
          config.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
